# ============================================================
# .gitignore TSSR (рефакторинг 2026-10-14)
# Правило: удаляй только проверенные мёртвые/дублирующиеся строки.
# Поведение до/после сверяется матрицей: tmp/gitignore_matrix.sh
# (60 путей, git check-ignore). Дубль старого блока и no-op-негации
# (игнорящих правил для них не было) удалены — исход сверен.
# ============================================================

# ===== Файлы игры (депо Steam) =====
# Официальные файлы депота игнорим; свои правки/созданные нами файлы —
# разрешаем конкретными строками (они же нужны для git add новых файлов).
game/*
!game/tl/
!game/fonts/
!game/language.rpy
!game/language_switcher.rpy
!game/screens.rpy
!game/options.rpy
!game/gui.rpy
!game/voice_config.rpy

# ===== Сборка/мусор игры =====
TheSurvivalofSarahRose-32.exe
TheSurvivalofSarahRose.exe
TheSurvivalofSarahRose.py
TheSurvivalofSarahRose.sh
errors.txt
traceback.txt
log.txt
game/tl/None/
extract_strings.py
renpy_download.html

# ===== SDK/внешние инструменты =====
renpy/
lib/
renpy-8.5.2-sdk/
renpy-sdk.zip

# ===== Логи и временные файлы =====
nul
*todo*
**debug**
output
tmp
tasks
# Runtime debug log (пишет voice_config.rpy)
*.log
__pycache__/
*.pyc
.playwright-cli
.sisyphus
# Атомарная запись конвертера/пайплайна: ffmpeg пишет .part, потом rename
*.part

# ===== Озвучка =====
# С 2026-10-14 новые файлы генерируются СРАЗУ в .opus (коммитятся).
# wav в ai_voice удалены 2026-10-14 (финальная миграция) — в этом каталоге
# только opus; wav остаются ТОЛЬКО в voice_candidates (рефы, не игнорируются).

# TSSR mod: диагностические файлы (пересоздаются при каждом запуске игры)
mod/update_check.txt
mod/last_menu_hook.txt
.playwright-mcp